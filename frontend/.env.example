# Canonical site URL for meta tags, JSON-LD, and sharing (no trailing slash).
# VITE_SITE_URL=https://www.youtubeboosterai.com

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When set, events are sent: channel_audit_started, demo_dashboard_viewed, pricing_viewed, checkout_started, purchase_completed.
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Search Console — content value for <meta name="google-site-verification">
# VITE_GOOGLE_SITE_VERIFICATION=your_token_here

# Build: sitemap.xml + robots.txt base URL (npm run build:seo). Default in script: https://www.youtubeboosterai.com
# SEO_SITE_URL=https://www.youtubeboosterai.com
