# Frontend
VITE_API_BASE_URL=https://api.example.com

# SEO (canonical URLs, OG/JSON-LD absolutes — must match deployed origin)
# VITE_SITE_URL=https://youtubeboosterai.com
# Optional: GA4
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional: Google Search Console HTML tag verification
# VITE_GOOGLE_SITE_VERIFICATION=your_token_here

# Build-time sitemap/robots base URL (use in CI; align with VITE_SITE_URL)
# SEO_SITE_URL=https://youtubeboosterai.com

# Backend app configuration

# YouTube Data API v3 key — required for demo to fetch real public channel data
# (e.g. https://www.youtube.com/@KeyWestWaterman). Your credentials.json (OAuth client)
# does not include an API key; create one in the same Google Cloud project:
#   APIs & Services → Credentials → Create credentials → API key → enable YouTube Data API v3
# Then set one of:
#   - Env: YOUTUBE_API_KEY=your_key_here
#   - SSM: /youtubebooster/youtube/api-key (secure)
#   - Or add to credentials JSON in SSM (admin/google/credentials-json) as top-level "youtube_api_key"
PRICING__ONETIMEPRICE=9.99
PRICING__CURRENCY=USD
STRIPE__PRICELOOKUPKEY=ytboosterai_default
SUPPORT__EMAIL=support@example.com
SSM__BASEPATH=/youtubebooster

# TODO: Store the following in AWS SSM Parameter Store, not in plaintext env files:
# /youtubebooster/ses/from-email
# /youtubebooster/ses/admin-email
# /youtubebooster/stripe/secret-key
# /youtubebooster/stripe/webhook-secret
# /youtubebooster/stripe/publishable-key
# /youtubebooster/stripe/price-lookup-key
# /youtubebooster/stripe/openai-api-key
# /youtubebooster/admin/email
# /youtubebooster/admin/password
# /youtubebooster/youtube/api-key
# /youtubebooster/admin/google/credentials-json
# /youtubebooster/admin/google/client-id
# /youtubebooster/admin/google/client-secret
# /youtubebooster/admin/google/project-id
# /youtubebooster/admin/google/auth-uri
# /youtubebooster/admin/google/token-uri
# /youtubebooster/admin/google/redirect-uri
# /youtubebooster/pricing/one-time-price
# /youtubebooster/pricing/currency
# /youtubebooster/features/enable-public-demo
# /youtubebooster/features/demo-rate-limit-per-hour

# Buyer-provided Google/YouTube settings should NOT go in SSM.
# They should be collected during onboarding and stored per user in app data,
# ideally encrypted before persistence.
